# Check we can record a mock from the command line
basic

# Don't just go on adding to an existing file
remove_old_file

# Check we don't bail out if intercept list is empty
empty_intercepts

# Write warnings if absolute paths provided for intercepts
absolute_intercepts

# Allow several different programs at the same time, make sure we record them in the right order...
concurrent_traffic

# Record can't find what it's supposed to record
command_not_found

# Commands that write non-ASCII text, in the locale encoding
non_ascii

# Commands that write UTF-8 whatever the locale, set with "encoding" in capturemockrc
utf8_output
